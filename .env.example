# Šablóna konfigurácie. Skopíruj tento súbor ako ".env" a doplň svoje kľúče.
# Súbor .env sa na GitHub NENAHRÁVA (je v .gitignore) – tento .env.example áno,
# preto sem nikdy nepíš skutočné kľúče.

# API Ninjas – databáza motoriek (https://api-ninjas.com)
NINJA_API_KEY=

# OpenRouter – AI asistent (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Bezplatné AI modely, skúšajú sa zľava doprava, kým niektorý neodpovie
AI_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free,openrouter/free

# 1 = v chate sa zobrazuje premýšľanie AI, 0 = rýchlejšie odpovede
AI_THINKING=1

# 1 = ladiaci režim (iba na vlastnom počítači!), 0 = vypnutý
FLASK_DEBUG=1

# SECRET_KEY netreba – vygeneruje sa automaticky do instance/secret_key
